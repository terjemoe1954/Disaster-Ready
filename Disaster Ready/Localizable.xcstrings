    "action.houseFire.prepare.detail" : {
      "comment" : "Offline preparedness guidance",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Practise escape routes and agree on an outdoor meeting point at a safe distance."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Øv på rømningsveier, og avtal et utendørs møtested på trygg avstand."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ฝึกใช้เส้นทางหนีไฟและตกลงกันเรื่องจุดนัดพบกลางแจ้งที่อยู่ห่างออกไปในระยะปลอดภัย"
