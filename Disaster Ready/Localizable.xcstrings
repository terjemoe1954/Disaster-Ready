    "shelter.follow_shelter_instructions.detail" : {
      "comment" : "Safety-critical war or security guidance",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Current authority instructions determine whether to shelter in place, evacuate, or use a civil-defence shelter."
