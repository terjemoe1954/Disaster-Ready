    "hero_subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal plans, offline maps and guides, go or no-go rules, and one-tap family updates in a single place."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personlige planer, offline-kart og guider, gå/ikke gå-regler og familieoppdateringer på ett sted."
