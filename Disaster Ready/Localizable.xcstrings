    "business_bullet_1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lead with “works without internet” in App Store copy."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løft fram «fungerer uten internett» i App Store-teksten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เน้นคำว่า “ใช้งานได้โดยไม่ต้องมีอินเทอร์เน็ต” ในคำอธิบาย App Store"
          }
        }
      }
    },
    "business_bullet_2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position it as a decision tool, not just a checklist."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plasser den som et beslutningsverktøy, ikke bare en sjekkliste."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางตำแหน่งให้เป็นเครื่องมือช่วยตัดสินใจ ไม่ใช่แค่เช็กลิสต์"
          }
        }
      }
    },
    "business_bullet_3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family sync stays optional so solo households still get full value offline."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familiesynk forblir valgfritt slik at aleneboende fortsatt får full verdi offline."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซิงก์ครอบครัวยังคงเป็นทางเลือก เพื่อให้ผู้ใช้เดี่ยวยังได้คุณค่าเต็มที่แบบออฟไลน์"
          }
        }
      }
    },
