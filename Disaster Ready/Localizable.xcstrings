    "action.flood.prepare.detail" : {
      "comment" : "Offline preparedness guidance",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Know the local flood risk and plan how to leave before routes become unsafe."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gjør dere kjent med den lokale flomrisikoen, og planlegg hvordan dere skal dra før rutene blir utrygge."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ศึกษาความเสี่ยงจากน้ำท่วมในพื้นที่ และวางแผนออกจากพื้นที่ก่อนที่เส้นทางจะไม่ปลอดภัย"
          }
        }
      }
    },
    "action.flood.prepare.title" : {
      "comment" : "Preparedness action title",
      "localizations" : {
