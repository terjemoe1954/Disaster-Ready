    "source.review_semantics" : {
      "comment" : "Safety explanation distinguishing a source review date from live information",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disaster Ready reviewed this guidance against the listed official source on the date above. This is not a live-update time. During an emergency, follow current instructions from public authorities."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disaster Ready gjennomgikk veiledningen mot den oppførte offisielle kilden på datoen ovenfor. Dette er ikke tidspunktet for en sanntidsoppdatering. Følg gjeldende instrukser fra offentlige myndigheter i en nødsituasjon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disaster Ready ตรวจสอบแนวทางนี้โดยเทียบกับแหล่งข้อมูลทางการที่ระบุไว้ ณ วันที่ด้านบน วันที่ดังกล่าวไม่ใช่เวลาที่ข้อมูลได้รับการอัปเดตแบบเรียลไทม์ เมื่อเกิดเหตุฉุกเฉิน ให้ปฏิบัติตามคำแนะนำล่าสุดจากหน่วยงานภาครัฐ"
          }
        }
      }
    },
    "source.reviewed.label" : {
