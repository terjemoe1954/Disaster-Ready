    "smart_supply.safety.authority_first" : {
      "comment" : "Authority-first security incident notice",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Current authority instructions determine whether to shelter or evacuate. This supply list does not make that decision."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gjeldende instrukser fra myndighetene avgjør om du skal søke ly eller evakuere. Forsyningslisten tar ikke denne avgjørelsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "คำสั่งล่าสุดจากหน่วยงานรัฐจะกำหนดว่าควรหลบภัยอยู่กับที่หรืออพยพ รายการเสบียงนี้ไม่ได้เป็นผู้ตัดสินใจเรื่องดังกล่าว"
          }
        }
      }
    },
    "smart_supply.safety.general" : {
      "comment" : "General supply safety notice",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prepare in advance and follow current instructions from emergency services and public authorities."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Forbered deg på forhånd, og følg gjeldende instrukser fra nødetatene og offentlige myndigheter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เตรียมพร้อมล่วงหน้าและปฏิบัติตามคำสั่งล่าสุดจากหน่วยบริการฉุกเฉินและหน่วยงานรัฐ"
          }
        }
      }
    },
    "smart_supply.safety.house_fire" : {
      "comment" : "Safety-critical active fire notice",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "During an active fire, leave immediately. Never delay evacuation to collect supplies or belongings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Forlat stedet umiddelbart ved en pågående brann. Utsett aldri evakueringen for å hente forsyninger eller eiendeler."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เมื่อเกิดไฟไหม้อยู่ในขณะนั้น ให้ออกไปทันที อย่าชะลอการอพยพเพื่อเก็บเสบียงหรือทรัพย์สิน"
          }
        }
      }
    },
