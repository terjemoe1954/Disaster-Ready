    "action.evacuation.prepare.detail" : {
      "comment" : "Offline preparedness guidance",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plan where to go, how to travel, and what essential items to bring."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Planlegg hvor dere skal dra, hvordan dere skal komme dere dit, og hvilke nødvendige ting dere skal ta med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "วางแผนว่าจะไปที่ไหน เดินทางอย่างไร และต้องนำสิ่งของจำเป็นอะไรไปบ้าง"
          }
        }
      }
    },
    "action.evacuation.prepare.title" : {
      "comment" : "Preparedness action title",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prepare your household"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Forbered husstanden"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เตรียมความพร้อมให้ครัวเรือน"
          }
        }
      }
    },
    "action.extremeWeather.prepare.detail" : {
      "comment" : "Offline preparedness guidance",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Secure loose items and prepare for disrupted transport, power, and communication."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sikre løse gjenstander, og forbered dere på forstyrrelser i transport, strømforsyning og kommunikasjon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ยึดสิ่งของที่อาจปลิวหรือเคลื่อนที่ให้แน่นหนา และเตรียมพร้อมรับมือการหยุดชะงักของการเดินทาง ไฟฟ้า และการสื่อสาร"
          }
        }
      }
    },
    "action.extremeWeather.prepare.title" : {
      "comment" : "Preparedness action title",
      "localizations" : {
        "en" : {
