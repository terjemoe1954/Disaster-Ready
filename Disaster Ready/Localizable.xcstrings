    "action.follow_official_information.detail" : {
      "comment" : "Safety-critical preparedness guidance",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Monitor official information and follow current instructions from local authorities."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Følg med på offisiell informasjon, og følg gjeldende instrukser fra lokale myndigheter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ติดตามข้อมูลทางการและปฏิบัติตามคำแนะนำล่าสุดจากหน่วยงานท้องถิ่น"
          }
        }
      }
    },
    "action.follow_official_information.title" : {
      "comment" : "Preparedness action title",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Follow official information"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Følg offisiell informasjon"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ติดตามข้อมูลทางการ"
          }
        }
      }
    },
    "action.gas_installation.prepare.detail" : {
      "comment" : "Gas preparedness guidance; never shown by default",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Record where the gas shutoff is and follow instructions from emergency services or a qualified professional."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Noter hvor gasstilførselen stenges, og følg instruksene fra nødetatene eller en kvalifisert fagperson."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "บันทึกตำแหน่งวาล์วปิดแก๊ส และปฏิบัติตามคำแนะนำจากหน่วยบริการฉุกเฉินหรือผู้เชี่ยวชาญที่มีคุณสมบัติเหมาะสม"
          }
        }
      }
    },
    "action.gas_installation.prepare.title" : {
      "comment" : "Shown only when a Norwegian household declares a gas installation",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prepare for the gas installation"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Forberedelser for gassanlegget"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เตรียมพร้อมสำหรับระบบแก๊ส"
          }
        }
      }
    },
    "action.hazardousRelease.prepare.detail" : {
      "comment" : "Offline preparedness guidance",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Know how to close doors and ventilation while awaiting official instructions."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vit hvordan dere lukker dører og stenger ventilasjonen mens dere venter på offisielle instrukser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "เรียนรู้วิธีปิดประตูและปิดระบบระบายอากาศระหว่างรอคำแนะนำอย่างเป็นทางการ"
          }
        }
      }
    },
