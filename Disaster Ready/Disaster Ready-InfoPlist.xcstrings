    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disaster Ready uses one location reading when you choose Use My Location to calculate shelter distances or match official weather warnings. Your location is not stored."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disaster Ready bruker én posisjonsmåling når du velger Bruk min posisjon, for å beregne avstander til tilfluktsrom eller finne relevante offisielle farevarsler. Posisjonen lagres ikke."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disaster Ready ใช้ข้อมูลตำแหน่งหนึ่งครั้งเมื่อคุณเลือกใช้ตำแหน่งของฉัน เพื่อคำนวณระยะทางไปยังที่หลบภัยหรือจับคู่คำเตือนสภาพอากาศทางการ โดยจะไม่จัดเก็บตำแหน่งของคุณ"
          }
        }
      }
    }
  },
  "version" : "1.3"
